rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profile doc holding onboarding state. Does not cascade to the subcollections below.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public-facing name + points only — kept separate from /users so friends never see
    // email, reminder settings, or other private profile data.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Single-use pairing code created by the inviter; the invitee reads it once to link up.
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.inviterUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.inviterUid;
    }

    // Immutable friend pairing, doc id is the two uids sorted and joined with "_".
    match /friendships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
    }

    match /users/{uid}/tasks/{taskId} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == resource.data.sharedWithUid);
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      // A friend a task is shared with may only flip completion state, never rewrite it.
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        (request.auth.uid == resource.data.sharedWithUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['done', 'completedByUid', 'completedByName', 'completedAt', 'subtasks']))
      );
    }

    // Collection-group access for tasks shared with the signed-in user.
    match /{path=**}/tasks/{taskId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.sharedWithUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.sharedWithUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['done', 'completedByUid', 'completedByName', 'completedAt', 'subtasks']);
    }

    // Daily AI-breakdown usage counter, one doc per user per calendar day (id = "YYYY-MM-DD").
    // Enforces the free-tier cap server-side so it can't be bypassed by editing client code.
    match /users/{uid}/usage/{day} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.breakdownCount == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.breakdownCount < 5
        && request.resource.data.breakdownCount == resource.data.breakdownCount + 1;
    }
  }
}


